# Supabase（必填）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# 網站 URL（本機開發用 localhost，Vercel 用正式網域）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2（圖片儲存：Demo 圖、草圖、客戶素材）
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=designpick
# 公開存取網域（R2 自訂網域或 r2.dev，例：https://images.desigpick-digital.com）
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.desigpick-digital.com
# 管理員 Email（逗號分隔，可多位）
ADMIN_EMAILS=your@email.com

# 瀏覽統計 IP 雜湊用鹽（選填，未設定時使用預設值；正式環境建議自訂）
# ANALYTICS_IP_SALT=your-random-secret-string

# Google Analytics 4（選填，在 GA4 後台取得 Measurement ID，例：G-XXXXXXXXXX）
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Demo 子網域根網域（選填，設定後 property-luxe-09.yourdomain.com 會指向對應 Demo）
# 例：designpick.hk → https://property-luxe-09.designpick.hk
# 例：designpick.hk → https://medical-trust-05.designpick.hk
NEXT_PUBLIC_DEMO_ROOT_DOMAIN=desigpick-digital.com

# Resend Email（選填，未設定時只 log 不發信）
RESEND_API_KEY=re_...
EMAIL_FROM=DesignPick <noreply@yourdomain.com>
NOTIFY_EMAIL=your@email.com
CONTACT_NAME=Terry
