# Supabase（必填）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# 網站 URL（本機開發用 localhost，Vercel 用正式網域）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 管理員 Email（逗號分隔，可多位）
ADMIN_EMAILS=your@email.com

# Demo 子網域根網域（選填，設定後 property-luxe-09.yourdomain.com 會指向對應 Demo）
# 例：designpick.hk → https://property-luxe-09.designpick.hk
NEXT_PUBLIC_DEMO_ROOT_DOMAIN=

# Resend Email（選填，未設定時只 log 不發信）
RESEND_API_KEY=re_...
EMAIL_FROM=DesignPick <noreply@yourdomain.com>
NOTIFY_EMAIL=your@email.com
CONTACT_NAME=Terry
